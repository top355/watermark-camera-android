<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏布局。
  横屏时画面是 4:3 居中、左右留黑边，所以把操作按钮收成右侧一条竖栏，
  收在右黑边上（屏够宽的机器上全在黑边里，16:9 的会压到画面右缘一点，
  见文件末尾 thumbRow 那段注释）；地点/张数留在左上角。

  两条硬约束，加控件前先看清楚：

  1. id 必须与竖屏版**逐一对齐** —— 代码只认 id、不认排布。
     唯一允许缺的是 topSpacer：它对代码是可选参数（applyTopBarWidths 收 View?），
     这份布局的顶栏本来就不吃满宽度、不需要那根撑杆。
     其余任何一个 id 缺失，ViewBinding 都会把字段生成成**可空**、主界面于是写安全调用 ——
     点下去毫无反应也不报错。「横着启动 App 点不到从相册加水印」就是这么来的，
     现在由 LayoutParityTest 逐条盯着两份布局的 id 集合。

  2. 高度是硬约束：360dp 高的横屏上，这条右栏（倍率行 38 + 操作栏 296）已经占掉 334dp。
     想加东西基本只能靠"并排"而不是"再加一行"。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            fillCenter，不是 fitCenter。
            （注意 PreviewView 的 scaleType **没有 centerCrop 这个取值** —— 它的枚举是
            fill*/fit* 两组，`fill` 就是"填满整个视图、把超出的部分裁掉"，`fit` 才是留黑边的 letterbox。
            写 centerCrop 会直接资源链接失败。）

            为什么必须换：比例由设置决定（4:3 / 16:9 / 1:1），而**裁剪是我们自己居中做的** ——
            不能指望相机支持 1:1（很多机型只出 4:3 和 16:9，协商失败会静默退回）。
            所以这块取景框按目标比例摆，fillCenter 让它露出的正好是同一块居中区域，
            黑边里的内容不会被拍进去 —— 「取景框里看到的」就等于「存下来的」。
            默认 4:3 时目标比例与采集比例相同，fillCenter 与原来的 fitCenter 完全等效。
        -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- 尺寸与位置由代码设成和上面那块取景画面完全一致，保证与出图一致 -->
        <com.daka.watermarkcamera.WatermarkOverlayView
            android:id="@+id/overlay"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <!-- 点一下就能在拍照界面直接改地点，不用进设置页 -->
        <LinearLayout
            android:id="@+id/gpsPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/gpsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_wait" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location" />

            <TextView
                android:id="@+id/gpsTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text="@string/addr_placeholder"
                android:textColor="@color/hud_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cntPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="@string/shot_count_zero"
            android:textColor="@color/hud_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!--
      右侧竖排操作栏 + 它上面的倍率档位行。
      横屏时画面是 4:3 居中、左右有黑边，操作栏收在右黑边上；倍率行摆不下竖排
      （五档 × 36dp 加上按钮列会超过屏幕高度），所以还是横着，靠右下角对齐。
      整体竖着叠，位置由操作栏实测高度决定 —— 理由同竖屏版。
    -->
    <LinearLayout
        android:id="@+id/bottomStack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/zoomScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/zoomBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/flash_toggle"
                android:src="@drawable/ic_flash_off" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btnFlip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/flip_camera"
                android:src="@drawable/ic_flip" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/shoot" />

            <!--
              最后一行：上一张 + 相册加水印，**并排两颗**。

              为什么必须并排、不能各占一行：横屏的高度预算是**硬约束**。
              这条右栏（倍率行 38dp + 操作栏 296dp）在 360dp 高的横屏上已经占掉 334dp，
              只剩 26dp —— 再塞一行 46dp 的按钮，最上面的闪光灯会被顶到屏幕外
              （BottomBarLayoutTest 那条横屏用例就是量这个的）。

              为什么不干脆再收窄一点挤进去：要腾出 30dp 得把快门、翻转、闪光灯
              和四个间距统统改小，档位和点击区都得缩水，为一个入口动整条栏不值。

              代价是这一列变宽：46+10+46 加 18dp 内边距 = 120dp（原先 82dp，
              由 64dp 的快门决定）。16:9 横屏的左右黑边各 80dp，所以右边缘会压到
              4:3 画面约 40dp；19.5:9 / 20:9 的机器黑边有 150dp 以上，仍在黑边里。
              这和倍率行本来就越出黑边是同一个量级，属于这套横屏版式既有的取舍。

              id 必须与竖屏版一致 —— 代码只认 id、不认排布。竖屏那份里
              thumb 和 btnGallery 也是并排的（52dp + 10dp 间距），这里保持一致。
              漏一个 id 的后果很隐蔽：ViewBinding 发现某 id 只在部分变体里存在时
              会把字段生成成**可空**，主界面于是写安全调用，点下去毫无反应也不报错 ——
              「横着启动 App 点不到从相册加水印」就是这么来的，现在有
              LayoutParityTest 盯着两份布局的 id 集合。
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/thumb"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_thumb"
                    android:clipToOutline="true"
                    android:contentDescription="@string/last_shot"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_placeholder" />

                <!-- 相册里的图也能加水印 —— 补拍、事后补录的场景全靠它。id 与竖屏版同一个 -->
                <ImageButton
                    android:id="@+id/btnGallery"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="@string/pick_photo"
                    android:src="@drawable/ic_gallery" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
