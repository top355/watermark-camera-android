<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏布局。
  横屏时画面是 4:3 居中、左右留黑边，所以把操作按钮收成右侧一条竖栏，
  不压在画面上；地点/张数留在左上角。
  id 必须与竖屏版完全一致 —— 代码只认 id，不认排布。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <!-- 尺寸由代码按相机画面比例设定，保证与出图一致 -->
        <com.daka.watermarkcamera.WatermarkOverlayView
            android:id="@+id/overlay"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <!-- 点一下就能在拍照界面直接改地点，不用进设置页 -->
        <LinearLayout
            android:id="@+id/gpsPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/gpsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_wait" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location" />

            <TextView
                android:id="@+id/gpsTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text="@string/addr_placeholder"
                android:textColor="@color/hud_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cntPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="@string/shot_count_zero"
            android:textColor="@color/hud_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 右侧竖排操作栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/flash_toggle"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnFlip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round"
            android:contentDescription="@string/flip_camera"
            android:src="@drawable/ic_flip" />

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/shoot" />

        <ImageButton
            android:id="@+id/thumb"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true"
            android:contentDescription="@string/last_shot"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder" />
    </LinearLayout>
</FrameLayout>
