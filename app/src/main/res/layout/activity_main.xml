<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            fillCenter，不是 fitCenter。
            （注意 PreviewView 的 scaleType **没有 centerCrop 这个取值** —— 它的枚举是
            fill*/fit* 两组，`fill` 就是"填满整个视图、把超出的部分裁掉"，`fit` 才是留黑边的 letterbox。
            写 centerCrop 会直接资源链接失败。）

            为什么必须换：比例由设置决定（4:3 / 16:9 / 1:1），而**裁剪是我们自己居中做的** ——
            不能指望相机支持 1:1（很多机型只出 4:3 和 16:9，协商失败会静默退回）。
            所以这块取景框按目标比例摆，fillCenter 让它露出的正好是同一块居中区域，
            黑边里的内容不会被拍进去 —— 「取景框里看到的」就等于「存下来的」。
            默认 4:3 时目标比例与采集比例相同，fillCenter 与原来的 fitCenter 完全等效。
        -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- 尺寸与位置由代码设成和上面那块取景画面完全一致，保证与出图一致 -->
        <com.daka.watermarkcamera.WatermarkOverlayView
            android:id="@+id/overlay"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!--
          顶栏左上的地点胶囊。点一下就能在拍照界面直接改地点，不用进设置页。

          宽度**不在这里定死**，而是按当前屏宽在代码里切两支
          （见 HudSize.applyTopBarWidths）：

            屏不够宽（手机竖屏）→ 0dp + weight=1 吃满剩余宽度，也就是下面写的这一支。
            这是窄屏上唯一的活路：原来写 wrap_content 时，地点一长整行的需求宽度
            就超过屏宽，而 LinearLayout 不压缩前面的子项、只把后面的摆到屏幕外 ——
            表现就是「设置图标显示不全」。

            屏够宽（横屏 / 平板竖屏）→ 代码改成 wrap_content，最多 HudSize.gpsMaxDp
            （约 258dp 一条），剩下的宽度交给下面那个 topSpacer 吃掉，
            右边三个控件仍然贴右边缘。

          为什么必须放在代码里算：Activity 声明了 configChanges（见 manifest），
          **旋转不重建、布局也不重新充气** —— 横屏时屏幕上还是竖屏这套 View，
          只是被量成了横屏的宽度。写死在 XML 里的话，横屏拿到的是"竖屏值被拉宽"的产物，
          胶囊会一路长到 680dp、横贯整个屏幕。
        -->
        <LinearLayout
            android:id="@+id/gpsPill"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/gpsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_wait" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location" />

            <!--
              宽度是 wrap_content，**不要给它 weight=1**：
              那样文字会撑满整个胶囊，屏幕一宽胶囊就跟着变长（横屏就是这么长的）。
              文字上限由代码按当前屏宽给（HudSize.GPS_TEXT_MAX_DP），
              理由同上 —— 旋转不重新充气，写死在 XML 里对横屏无效。

              不写 weight 也照样会缩：胶囊自己是被父容器约束的，
              长地址在 AT_MOST 下会自己省略号，窄屏上和原来的表现逐像素一致。
            -->
            <TextView
                android:id="@+id/gpsTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/addr_placeholder"
                android:textColor="@color/hud_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!--
          右对齐撑杆。

          屏够宽时由代码把 weight 设成 1：吃掉胶囊没收的那段宽度，
          让右边三个控件继续贴着右边缘（不设它的话，胶囊一收窄，
          设置图标就会跟着往中间跑）。屏不够宽时归零。

          横屏那份布局（layout-land）的顶栏本来就是 wrap_content、控件也是靠左站的，
          不需要这个撑杆，所以那个文件里没有这个 id —— ViewBinding 生成的是可空字段，
          HudSize.applyTopBarWidths 的 gap 参数因此写成可空。
        -->
        <Space
            android:id="@+id/topSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/cntPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="@string/shot_count_zero"
            android:textColor="@color/hud_text"
            android:textSize="12.5sp" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/flash_toggle"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!--
      底部整体竖着叠：上面是倍率档位行，下面是操作栏。

      为什么不把倍率行单独用 layout_gravity + marginBottom 摆到操作栏上面：
      操作栏的高度不是固定的（快门 76dp + 内边距 + 系统的导航栏 inset），
      写死的 marginBottom 换台机器就会和快门压在一起、或者飘在半空。
      叠在一个竖LinearLayout 里，位置永远由操作栏自己的实测高度决定，零魔法数字。

      id 必须叫 bottomBar 且留在原地 —— applyInsets() 和 BottomBarLayoutTest
      都按这个 id 找它。
    -->
    <LinearLayout
        android:id="@+id/bottomStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!--
          倍率档位。整行由 ZoomBar 在代码里建（档位是设备能力的函数，
          见 Zoom.presets），这里只留容器。

          套 HorizontalScrollView 是窄屏兜底：五档在 320dp 上本来排得下，
          但万一某台机器给出一组更宽的标签（0.6x / 10x 混排），
          宁可让它能横向拖，也不要被裁掉一半。
        -->
        <HorizontalScrollView
            android:id="@+id/zoomScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <!--
              gravity=center 把档位摆在这一行的中间。
              注意是**容器自己的 gravity**，不是 layout_gravity ——
              外面 fillViewport 之后子项被拉到满宽，layout_gravity 就没有作用了。
            -->
            <LinearLayout
                android:id="@+id/zoomBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@string/last_shot"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <!--
              给相册里的图加水印。放在缩略图右边而不是顶栏：顶栏已经被
              地点重量过（见 topBar 注释），再加东西会在窄屏上把设置图标顶出去。
            -->
            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/pick_photo"
                android:src="@drawable/ic_gallery" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/shoot" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnFlip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/flip_camera"
                android:src="@drawable/ic_flip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
